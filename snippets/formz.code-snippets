      "  const UrlInput.dirty([String value = '']) : super.dirty(value);",
      "",
      "  static final _reg = RegExp(r'^(https?:\\/\\/)?[\\w.-]+\\.[a-zA-Z]{2,}.*\\$');",
      "",
