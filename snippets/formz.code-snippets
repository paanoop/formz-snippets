  "Formz String Input": {
    "prefix": "formzInputString",
    "body": [
      "import 'package:formz/formz.dart';",
      "",
      "enum ${1:Field}ValidationError { invalid }",
      "",
      "class ${1:Field}Input extends FormzInput<String, ${1:Field}ValidationError> {",
      "  const ${1:Field}Input.pure() : super.pure('');",
      "  const ${1:Field}Input.dirty([String value = '']) : super.dirty(value);",
      "",
      "  @override",
      "  ${1:Field}ValidationError? validator(String value) {",
      "    if (value.isEmpty) return ${1:Field}ValidationError.invalid;",
      "    return null;",
      "  }",
      "}"
    ],
    "description": "Formz input for String values with basic non-empty validation"
  },

