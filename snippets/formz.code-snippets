{
  // -----------------------------
  // STRING INPUT
  // -----------------------------
  "Formz String Input": {
    "prefix": "formzString",
    "body": [
      "enum ${1:Name}ValidationError { invalid }",
      "",
      "class ${1:Name}Input extends FormzInput<String, ${1:Name}ValidationError> {",
      "  const ${1:Name}Input.pure() : super.pure('');",
      "  const ${1:Name}Input.dirty([String value = '']) : super.dirty(value);",
      "",
      "  @override",
      "  ${1:Name}ValidationError? validator(String value) {",
      "    if (value.isEmpty) return ${1:Name}ValidationError.invalid;",
      "    return null;",
      "  }",
      "}"
    ],
    "description": "Creates a Formz String input validator class."
  },
  // -----------------------------
  // NULLABLE STRING
  // -----------------------------
  "Formz Nullable String Input": {
    "prefix": "formzNullableString",
    "body": [
      "enum ${1:Name}ValidationError { invalid }",
      "",
      "class ${1:Name}Input extends FormzInput<String?, ${1:Name}ValidationError> {",
      "  const ${1:Name}Input.pure() : super.pure(null);",
      "  const ${1:Name}Input.dirty([String? value]) : super.dirty(value);",
      "",
      "  @override",
      "  ${1:Name}ValidationError? validator(String? value) {",
      "    if (value == null || value.isEmpty) return ${1:Name}ValidationError.invalid;",
      "    return null;",
      "  }",
      "}"
    ],
    "description": "Nullable string Formz input."
  },
  // -----------------------------
  // INT INPUT
  // -----------------------------
  "Formz Int Input": {
    "prefix": "formzInt",
    "body": [
      "enum ${1:Count}ValidationError { invalid }",
      "",
      "class ${1:Count}Input extends FormzInput<int, ${1:Count}ValidationError> {",
      "  const ${1:Count}Input.pure() : super.pure(0);",
      "  const ${1:Count}Input.dirty([int value = 0]) : super.dirty(value);",
      "",
      "  @override",
      "  ${1:Count}ValidationError? validator(int value) {",
      "    return null;",
      "  }",
      "}"
    ],
    "description": "Integer Formz input."
  },
  // -----------------------------
  // DOUBLE INPUT
  // -----------------------------
  "Formz Double Input": {
    "prefix": "formzDouble",
    "body": [
      "enum ${1:Amount}ValidationError { invalid }",
      "",
      "class ${1:Amount}Input extends FormzInput<double, ${1:Amount}ValidationError> {",
      "  const ${1:Amount}Input.pure() : super.pure(0.0);",
      "  const ${1:Amount}Input.dirty([double value = 0.0]) : super.dirty(value);",
      "",
      "  @override",
      "  ${1:Amount}ValidationError? validator(double value) {",
      "    return null;",
      "  }",
      "}"
    ],
    "description": "Double Formz input."
  },
  // -----------------------------
  // EMAIL
  // -----------------------------
  "Formz Email Input": {
    "prefix": "formzEmail",
    "body": [
      "enum EmailValidationError { invalid }",
      "",
      "class EmailInput extends FormzInput<String, EmailValidationError> {",
      "  const EmailInput.pure() : super.pure('');",
      "  const EmailInput.dirty([String value = '']) : super.dirty(value);",
      "",
      "  static final _reg = RegExp(r'^[\\w-\\.]+@([\\w-]+\\.)+[a-zA-Z]{2,4}\\$');",
      "",
      "  @override",
      "  EmailValidationError? validator(String value) {",
      "    if (!_reg.hasMatch(value)) return EmailValidationError.invalid;",
      "    return null;",
      "  }",
      "}"
    ],
    "description": "Email validator (regex)."
  },
  // -----------------------------
  // PASSWORD
  // -----------------------------
  "Formz Password Input": {
    "prefix": "formzPassword",
    "body": [
      "enum PasswordValidationError { short, invalid }",
      "",
      "class PasswordInput extends FormzInput<String, PasswordValidationError> {",
      "  const PasswordInput.pure() : super.pure('');",
      "  const PasswordInput.dirty([String value = '']) : super.dirty(value);",
      "",
      "  @override",
      "  PasswordValidationError? validator(String value) {",
      "    if (value.length < 6) return PasswordValidationError.short;",
      "    return null;",
      "  }",
      "}"
    ],
    "description": "Password input validator."
  },
  // -----------------------------
  // MOBILE (India)
  // -----------------------------
  "Formz Mobile Input": {
    "prefix": "formzMobile",
    "body": [
      "enum MobileValidationError { invalid }",
